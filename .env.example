# Required - your Anthropic API key (never commit the real .env)
ANTHROPIC_API_KEY=replace-me

# Claude model for answers. Default: claude-opus-4-8 (best quality).
# For a cheap public demo you can set: claude-haiku-4-5
MODEL=claude-opus-4-8

# Optional tuning (defaults shown)
# MAX_TOKENS=2048
# TOP_K=8
# PUBLIC_BADGE_LABEL=Hybrid RAG + Citations + Live Evals
# MAX_UPLOAD_MB=5
# MAX_DOCS=20
# RATE_LIMIT_ASK=10/minute
# LEMMA_DATA_DIR=./data
